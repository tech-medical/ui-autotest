# ==================== 环境配置 ====================
# 复制此文件为 .env 并填写实际值

# 测试环境 URL
BASE_URL=https://test.portal.fastreat.com

# 浏览器配置
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=false            # true | false
SLOW_MO=0                 # 慢放毫秒数，0 = 不慢放
TIMEOUT=30000             # 默认超时（毫秒）

# 截图配置
SCREENSHOT_ON_FAILURE=true

# 日志级别
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# 数据库配置（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_test
DB_POOL_SIZE=5
